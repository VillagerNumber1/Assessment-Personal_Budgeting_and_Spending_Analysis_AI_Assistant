# 虚拟环境
.venv/

# Python 缓存
__pycache__/
*.py[cod]

# 模型权重：461 MB，用 download_model.py 获取，不进仓库
models/

# 录音、数据库、上传的小票：都是个人隐私数据
data/

# 临时实验代码
temp_trying/

# 交接文档：含本机路径和踩坑记录，不进公开仓库
HANDOFF*.md
HANDOFF_LIVE2D.md

# 考核方发的资料，不属于我们的作品
资料库/

# 密钥和本地配置（.env.example 是模板，要进仓库）
.env
.env.*
!.env.example

# 编辑器配置
.vscode/
.idea/

# 系统垃圾
Thumbs.db
.DS_Store
*.log
.test-tmp/
