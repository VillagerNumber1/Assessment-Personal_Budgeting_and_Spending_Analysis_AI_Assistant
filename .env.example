# 复制本文件为 .env，填上你自己的 key
#   copy .env.example .env
#
# .env 已在 .gitignore 里，不会进仓库；这个模板文件会进仓库。
# 申请地址：https://platform.deepseek.com/

# DeepSeek API Key（形如 sk-xxxxxxxx）
DEEPSEEK_API_KEY=

# 语音识别走哪条路：
#   local —— 只用本地 whisper（不需要 key，慢一点）
#   cloud —— 只用 DeepSeek 在线识别（要 key，快）
#   auto  —— 有 key 就用云端，云端失败自动退回本地
ASR_BACKEND=auto
